local function getSaveData()
    local data = {}
    for name, state in pairs(toggleStates) do data[name] = state end
    return data
end

local function applySaveData(data)
    for name, state in pairs(data) do
        if toggleCallbacks[name] then toggleCallbacks[name](state) end
    end
end

local function generateKey(data)
    local json = HttpService:JSONEncode(data)
    local base64 = crypt and crypt.base64encode and crypt.base64encode(json) or json
    return "Tryscript_" .. base64
end

local function decodeKey(key)
    local raw = key:gsub("Tryscript_", "")
    local json = crypt and crypt.base64decode and crypt.base64decode(raw) or raw
    local success, res = pcall(function() return HttpService:JSONDecode(json) end)
    return success and res or nil
end

