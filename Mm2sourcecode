local cachedMurderer = nil
task.spawn(function()
    while true do
        task.wait(0.5)
        local success, m = pcall(function() return getPlayerByRole("Murderer") end)
        if success then cachedMurderer = m end
    end
end)

RunService.RenderStepped:Connect(function()
    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")

    local isHoldingGun = char:FindFirstChild("Gun") ~= nil
    if aimlockEnabled and isHoldingGun then
        if cachedMurderer and cachedMurderer.Character and cachedMurderer.Character:FindFirstChild("HumanoidRootPart") then
            local targetHrp = cachedMurderer.Character.HumanoidRootPart
            local basePos = targetHrp.Position
            
            local velocity = targetHrp.AssemblyLinearVelocity
            local predSpeed = getgenv().TryAimSettings.PredictionSpeed
            local aimSpeed = getgenv().TryAimSettings.AimlockSpeed
            
            local predictionOffset = Vector3.new(velocity.X * predSpeed, 0, velocity.Z * predSpeed)
            local verticalOffset = Vector3.new(0, math.clamp(velocity.Y * (predSpeed * 0.6), -1.5, 1.5), 0)
            
            local finalTargetPos = basePos + predictionOffset + verticalOffset
            local targetCFrame = CFrame.new(Camera.CFrame.Position, finalTargetPos)
            
            Camera.CFrame = Camera.CFrame:Lerp(targetCFrame, aimSpeed)
        end
    end

    if speedGlitchEnabled and hrp and hum and hum.MoveDirection.Magnitude > 0 then
        local state = hum:GetState()
        local isInAir = (state == Enum.HumanoidStateType.Freefall or state == Enum.HumanoidStateType.Jumping)
        if isInAir then
            hrp.CFrame = hrp.CFrame + (hum.MoveDirection * speedGlitchPower * 0.1)
        end
    end

    if noclipEnabled then
        local c = LocalPlayer.Character
        if c then
            for _, part in pairs(c:GetDescendants()) do
                if part:IsA("BasePart") then part.CanCollide = false end
            end
        end
    end

    if spinbotEnabled and hrp then
        hrp.CFrame = hrp.CFrame * CFrame.Angles(0, math.rad(spinbotSpeed), 0)
    end

    if antiFlingEnabled then
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character then
                for _, part in pairs(p.Character:GetDescendants()) do
                    if part:IsA("BasePart") then part.CanCollide = false end
                end
            end
        end
    end

    if roleEspEnabled then
        for _, player in pairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character then
                local role = getRole(player)
                local highlight = espHighlights[player]
                if not highlight or highlight.Parent ~= player.Character then
                    if highlight then highlight:Destroy() end
                    highlight = Instance.new("Highlight")
                    highlight.Parent = player.Character
                    highlight.Adornee = player.Character
                    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                    espHighlights[player] = highlight
                end
                highlight.FillColor = getRoleColor(role)
                highlight.FillTransparency = 0.4
            end
        end
    end

    if coinEspEnabled then
        for _, obj in pairs(Workspace:GetDescendants()) do
            if obj.Name == "CoinContainer" or obj.Name == "Coin" or obj.Name:find("Coin") then
                local part = obj:IsA("BasePart") and obj or obj:FindFirstChildWhichIsA("BasePart")
                if part then
                    local highlight = coinHighlights[obj]
                    if not highlight or highlight.Parent ~= part then
                        if highlight then highlight:Destroy() end
                        highlight = Instance.new("Highlight")
                        highlight.Parent = part
                        highlight.Adornee = part
                        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                        highlight.FillColor = Color3.fromRGB(255, 215, 0)
                        highlight.FillTransparency = 0.3
                        coinHighlights[obj] = highlight
                    end
                end
            end
        end
    else
        for _, h in pairs(coinHighlights) do if h then h:Destroy() end end
        table.clear(coinHighlights)
    end

    if gunDropEspEnabled then
        local gunFound = false
        for _, obj in pairs(Workspace:GetDescendants()) do
            if obj.Name == "Gun" or obj.Name == "GunDrop" then
                local part = obj:IsA("BasePart") and obj or obj:FindFirstChildWhichIsA("BasePart")
                if part then
                    gunFound = true
                    if not gunDropHighlight or gunDropHighlight.Parent ~= part then
                        if gunDropHighlight then gunDropHighlight:Destroy() end
                        gunDropHighlight = Instance.new("Highlight")
                        gunDropHighlight.Parent = part
                        gunDropHighlight.Adornee = part
                        gunDropHighlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                        gunDropHighlight.FillColor = Color3.fromRGB(0, 191, 255)
                        gunDropHighlight.FillTransparency = 0.2
                    end
                    break
                end
            end
        end
        if not gunFound and gunDropHighlight then
            gunDropHighlight:Destroy()
            gunDropHighlight = nil
        end
    else
        if gunDropHighlight then
            gunDropHighlight:Destroy()
            gunDropHighlight = nil
        end
    end
end)
