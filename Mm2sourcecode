local function grabGun()
    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local oldPos = hrp.CFrame
    local gunTarget = nil

    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj.Name == "Gun" or obj.Name == "GunDrop" then
            if obj:IsA("BasePart") then
                gunTarget = obj
                break
            elseif obj:IsA("Model") and obj.PrimaryPart then
                gunTarget = obj.PrimaryPart
                break
            else
                local part = obj:FindFirstChildWhichIsA("BasePart")
                if part then
                    gunTarget = part
                    break
                end
            end
        end
    end

    if gunTarget then
        hrp.CFrame = gunTarget.CFrame + Vector3.new(0, 0.5, 0)
        
        task.spawn(function()
            for i = 1, 5 do
                if gunTarget and gunTarget.Parent then
                    if firetouchinterest then
                        firetouchinterest(hrp, gunTarget, 0)
                        firetouchinterest(hrp, gunTarget, 1)
                    end
                end
                task.wait(0.05)
            end
        end)
        
        task.wait(0.15)
        hrp.CFrame = oldPos
    end
end

local function getRole(player)
    if not player then return "Innocent" end
    local success, playerData = pcall(function()
        local remote = ReplicatedStorage:FindFirstChild("GetPlayerData", true)
        if remote then return remote:InvokeServer() end
    end)
    if success and type(playerData) == "table" and playerData[player.Name] then
        local role = playerData[player.Name].Role
        if role == "Murderer" or role == "Sheriff" or role == "Hero" then
            return role == "Hero" and "Sheriff" or role
        end
    end
    local bp = player:FindFirstChild("Backpack")
    local ch = player.Character
    if (bp and bp:FindFirstChild("Knife")) or (ch and ch:FindFirstChild("Knife")) then
        return "Murderer"
    elseif (bp and bp:FindFirstChild("Gun")) or (ch and ch:FindFirstChild("Gun")) then
        return "Sheriff"
    end
    return "Innocent"
end

local function getRoleColor(role)
    if role == "Murderer" then return Color3.fromRGB(255, 40, 40) end
    if role == "Sheriff" then return Color3.fromRGB(40, 120, 255) end
    return Color3.fromRGB(40, 255, 120)
end

local function getPlayerByRole(targetRole)
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and getRole(p) == targetRole then return p end
    end
    return nil
end

local antiFlingEnabled = false

local function safeFling(targetPlayer)
    if not targetPlayer or not targetPlayer.Character then return end
    local targetHrp = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
    local myChar = LocalPlayer.Character
    local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
    local myHum = myChar and myChar:FindFirstChildOfClass("Humanoid")
    
    if not targetHrp or not myHrp or not myHum then return end
    
    local startCFrame = myHrp.CFrame
    myHum.PlatformStand = true
    
    local bav = Instance.new("BodyAngularVelocity")
    bav.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
    bav.AngularVelocity = Vector3.new(0, 99999, 0)
    bav.Parent = myHrp
    
    local bv = Instance.new("BodyVelocity")
    bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    bv.Velocity = Vector3.new(0, 0, 0)
    bv.Parent = myHrp
    
    local startTime = tick()
    while tick() - startTime < 0.6 do
        if not targetHrp or not targetHrp.Parent or not myHrp or not myHrp.Parent then break end
        myHrp.CFrame = targetHrp.CFrame * CFrame.new(math.random(-0.5, 0.5), 0, math.random(-0.5, 0.5))
        bv.Velocity = Vector3.new(math.random(-500, 500), 5000, math.random(-500, 500))
        RunService.Heartbeat:Wait()
    end
    
    if bav then bav:Destroy() end
    if bv then bv:Destroy() end
    
    myHrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
    myHrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
    myHum.PlatformStand = false
    myHrp.CFrame = startCFrame
end

